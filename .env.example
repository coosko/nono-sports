# Variables de entorno para credenciales y configuración.
#
# En desarrollo puedes copiar este fichero a .env.
# En Nono es preferible usar ~/.config/nono-sports/env con permisos 600.
NONO_SPORT_DATA_ROOT="/mnt/h/Mi unidad/01_ambitos/02_personal/40_deporte"
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost/exchange_token
LOG_LEVEL=INFO
